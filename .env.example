# Copy to apps/web/.env.local for local development.
# Never commit real values or paste secrets into issues, logs, or chat.
# Auth0 SDK v4 uses AUTH0_DOMAIN (hostname only) and APP_BASE_URL.
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# Optional: only when the application requests access tokens for a configured Auth0 API.
AUTH0_AUDIENCE=

# Optional until the database-backed feature is implemented.
# Use a non-production Neon branch and a least-privilege LOGIN role.
DATABASE_URL=

# Optional and server-side only; do not configure until a feature explicitly needs
# the Auth0 Management API and the client has minimum required scopes.
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
