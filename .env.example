# Copy to apps/web/.env.local for local development.
# Never commit real values. Auth0 SDK v4 uses AUTH0_DOMAIN (without https://) and APP_BASE_URL.
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_AUDIENCE=
# Runtime: direct endpoint while Neon pooler is disabled; pooled (-pooler) only after separate verification.
DATABASE_URL=
# Migration-only: Neon direct endpoint (no -pooler); never expose to the web runtime.
# Configure only in a protected migration job/environment when that workflow exists.
DATABASE_MIGRATION_URL=
# Fail-closed identity sync; enable only in reviewed isolated Preview.
AUTH0_NEON_SYNC_ENABLED=false
# Optional, server-side only. Configure only when the feature is implemented.
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
VERCEL_API_TOKEN=
# Exact LOGIN role expected by the authenticated /api/ready probe.
# Presence of this value is not proof of effective grants or tenant isolation.
DATABASE_RUNTIME_ROLE=iam_app_runtime_login
# Server-only 32-byte hex HMAC secret, from the SAME isolated database branch's
# active app_private.context_keys row. Configure only as a protected, branch-scoped
# Vercel sensitive environment variable. Never place a real value here, in git,
# a browser bundle, an API payload or an Auth0 claim. Do not reuse a Production key.
# Absence or mismatch causes the authorization API to deny every request.
AUTHZ_CONTEXT_SIGNING_KEY_HEX=
