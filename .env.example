# Copy to apps/web/.env.local for local development.
# Never commit real values. Auth0 SDK v4 uses AUTH0_DOMAIN (without https://) and APP_BASE_URL.
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_AUDIENCE=
# Runtime: Neon pooled endpoint (-pooler), least-privilege runtime login.
DATABASE_URL=
# Migration-only: Neon direct endpoint (no -pooler); never expose to the web runtime.
# Configure only in a protected migration job/environment when that workflow exists.
DATABASE_MIGRATION_URL=
# Optional, server-side only. Configure only when the feature is implemented.
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
VERCEL_API_TOKEN=
